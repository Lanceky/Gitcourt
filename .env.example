NODE_ENV=development
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.nhvcdnteolcqzwbhkgus.supabase.co:5432/postgres
NEXT_PUBLIC_API_BASE_URL=
GIT_REPOSITORIES_PATH=.data/repositories
CORS_ALLOWED_ORIGINS=http://localhost:3000
AI_SUMMARY_ENABLED=false
AI_SUMMARY_API_URL=
AI_SUMMARY_API_KEY=
AI_SUMMARY_MODEL=configured-model
AI_SUMMARY_TIMEOUT_MS=8000

# Vercel: set NEXT_PUBLIC_API_BASE_URL to the Render API origin before building.
# Render: set DATABASE_URL to the Supabase PostgreSQL connection string,
# GIT_REPOSITORIES_PATH=/var/data/repositories, and CORS_ALLOWED_ORIGINS to the
# exact Vercel production origin.
